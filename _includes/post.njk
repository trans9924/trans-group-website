<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | TRANS GROUP</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">TRANS <span>GROUP</span>
      <small>BUSINESS • INNOVATION • GROWTH</small>
    </a>
    <nav>
      <a href="/">Home</a>
      <a href="/#businesses">Our Businesses</a>
      <a href="/blog.html">Business Blog</a>
      <a href="/admin/">Blog Admin</a>
    </nav>
  </header>

  <main class="section">
    <p class="eyebrow">{{ category }}</p>
    <h1>{{ title }}</h1>
    {% if title_bn %}
      <h2>{{ title_bn }}</h2>
    {% endif %}
    <p>{{ description }}</p>

    {% if thumbnail %}
      <img src="{{ thumbnail }}" alt="{{ title }}">
    {% endif %}

    <article class="post-content">
      {{ content | safe }}
    </article>

    {% if body_bn %}
      <hr>
      <h2>বাংলা সংস্করণ</h2>
      <div class="post-content">{{ body_bn | safe }}</div>
    {% endif %}

    <a href="/blog.html">← Back to Business Blog</a>
  </main>

  <footer>
    <p>© TRANS GROUP. All rights reserved.</p>
    <a href="/admin/">Blog Admin</a>
  </footer>
</body>
</html>
